digraph examples_ktor_graph_examples_architecture_01 {
  graph [rankdir=LR, bgcolor="transparent", margin=0.1, nodesep=0.7, ranksep=0.9]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#9aa8b8", fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#738295", arrowsize=0.8]
  client [label="HTTP Client"];
  routes [label="Ktor Routes"];
  plugin [label="GraphPlugin"];
  tinker [label="TinkerGraph"];
  falkor [label="FalkorDB"];
  client -> routes [label="request"];
  routes -> plugin [label="facade"];
  plugin -> tinker [label="default"];
  plugin -> falkor [label="optional"];
}
