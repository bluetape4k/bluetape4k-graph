digraph "graph-graph-core-architecture-14" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="graph core Architecture 14";
  n0 [label="Start shortest Path/all Paths", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="Initialize Search startId, toId, maxDepth", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="Path Cached?", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="Return from Cache", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="Execute BFS/Dijkstra", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="Path Found?", fillcolor="#F1ECFF", color="#8A72D6"];
  n6 [label="Construct GraphPath [V1, E1, V2, ...]", fillcolor="#F7F1E7", color="#B88A44"];
  n7 [label="Path = null or empty list", fillcolor="#EEF6D9", color="#8BA84D"];
  n8 [label="Cache Result", fillcolor="#E8F3FF", color="#5B8DEF"];
  n9 [label="Return GraphPath", fillcolor="#EAF7EF", color="#58A978"];
  n10 [label="End", fillcolor="#FFF3D9", color="#D6A441"];
  n9 -> n10 [style="solid"];
  n7 -> n9 [style="solid"];
  n3 -> n9 [style="solid"];
  n8 -> n9 [style="solid"];
  n6 -> n8 [style="solid"];
  n5 -> n7 [style="solid"];
  n5 -> n6 [style="solid"];
  n4 -> n5 [style="solid"];
  n2 -> n4 [style="solid"];
  n2 -> n3 [style="solid"];
  n1 -> n2 [style="solid"];
  n0 -> n1 [style="solid"];
}
