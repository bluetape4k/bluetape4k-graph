digraph examples_linkedin_graph_examples_erd_02 {
  graph [rankdir=LR, bgcolor="transparent", margin=0.1, nodesep=0.7, ranksep=0.9]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#9aa8b8", fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#738295", arrowsize=0.8]
  person [label="Person"];
  company [label="Company"];
  skill [label="Skill"];
  peer [label="Other Person"];
  person -> company [label="WORKS_AT"];
  person -> skill [label="HAS_SKILL"];
  person -> peer [label="KNOWS / FOLLOWS"];
  peer -> person [label="ENDORSES"];
}
