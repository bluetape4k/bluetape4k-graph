digraph "ktor-graph-ktor-architecture-01" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="graph ktor Architecture";
  n0 [label="Ktor Application", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="install(GraphPlugin)", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="GraphPluginConfig", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="GraphPluginState", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="GraphOperations", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="Graph Suspend Operations", fillcolor="#F1ECFF", color="#8A72D6"];
  n6 [label="Route Handler", fillcolor="#F7F1E7", color="#B88A44"];
  n7 [label="call.graph Suspend Operations()", fillcolor="#EEF6D9", color="#8BA84D"];
  n7 -> n5 [style="solid"];
  n6 -> n7 [style="solid"];
  n3 -> n5 [style="solid"];
  n3 -> n4 [style="solid"];
  n2 -> n3 [style="solid"];
  n1 -> n2 [style="solid"];
  n0 -> n1 [style="solid"];
}
