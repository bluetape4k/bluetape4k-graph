digraph backend_capability_matrix {
    graph [
        rankdir=TB,
        bgcolor="transparent",
        pad=0.25,
        margin=0,
        nodesep=0.35,
        ranksep=0.45
    ];

    node [
        shape=plain,
        margin=0,
        fontname="Comic Mono"
    ];

    matrix [
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#334155">
                <TR>
                    <TD COLSPAN="7" BGCOLOR="#334155" CELLPADDING="18">
                        <FONT FACE="Architects Daughter" POINT-SIZE="30" COLOR="#FFFFFF">bluetape4k-graph Backend Capability Matrix</FONT>
                    </TD>
                </TR>
                <TR>
                    <TD COLSPAN="7" BGCOLOR="#E2E8F0" CELLPADDING="10">
                        <FONT FACE="Comic Mono" POINT-SIZE="14" COLOR="#334155">Shared GraphOperations contract with backend-specific capability strength</FONT>
                    </TD>
                </TR>
                <TR>
                    <TD BGCOLOR="#F8FAFC" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#0F172A">Backend</FONT></TD>
