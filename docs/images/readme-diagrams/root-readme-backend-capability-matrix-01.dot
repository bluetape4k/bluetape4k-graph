                    <TD BGCOLOR="#F8FAFC" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#0F172A">Merge</FONT></TD>
                    <TD BGCOLOR="#F8FAFC" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#0F172A">Transaction</FONT></TD>
                    <TD BGCOLOR="#F8FAFC" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#0F172A">Best Fit</FONT></TD>
                </TR>
                <TR>
                    <TD BGCOLOR="#DBEAFE" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#1E3A8A">Neo4j</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#1E3A8A">graph-neo4j</FONT></TD>
                    <TD BGCOLOR="#EFF6FF" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#1E3A8A">Cypher<BR/>Neo4j server</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native batch</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Index + unique</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native MERGE</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Driver tx</FONT></TD>
                    <TD BGCOLOR="#EFF6FF" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#1E3A8A">Default production graph DB</FONT></TD>
                </TR>
                <TR>
                    <TD BGCOLOR="#CCFBF1" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#134E4A">Memgraph</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#134E4A">graph-memgraph</FONT></TD>
                    <TD BGCOLOR="#F0FDFA" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#134E4A">Cypher<BR/>Bolt-compatible</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native batch</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Index + unique</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native MERGE</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Driver tx</FONT></TD>
                    <TD BGCOLOR="#F0FDFA" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#134E4A">Low-latency graph analytics</FONT></TD>
                </TR>
                <TR>
                    <TD BGCOLOR="#EDE9FE" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#4C1D95">Apache AGE</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#4C1D95">graph-age</FONT></TD>
                    <TD BGCOLOR="#F5F3FF" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#4C1D95">Cypher-over-SQL<BR/>PostgreSQL + AGE</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native batch</FONT></TD>
                    <TD BGCOLOR="#FEE2E2" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#991B1B">Explicit unsupported</FONT></TD>
                    <TD BGCOLOR="#FEF3C7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#92400E">Tx fallback</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Exposed tx</FONT></TD>
                    <TD BGCOLOR="#F5F3FF" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#4C1D95">PostgreSQL consolidation</FONT></TD>
                </TR>
                <TR>
                    <TD BGCOLOR="#FED7AA" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#7C2D12">TinkerGraph</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#7C2D12">graph-tinkerpop</FONT></TD>
                    <TD BGCOLOR="#FFF7ED" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#7C2D12">Gremlin<BR/>JVM in-memory</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">In-memory batch</FONT></TD>
                    <TD BGCOLOR="#FEF3C7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#92400E">Index metadata<BR/>no unique</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Gremlin upsert</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">In-memory tx</FONT></TD>
                    <TD BGCOLOR="#FFF7ED" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#7C2D12">Tests, demos, local analysis</FONT></TD>
                </TR>
                <TR>
                    <TD BGCOLOR="#FCE7F3" CELLPADDING="10"><FONT FACE="Architects Daughter" POINT-SIZE="18" COLOR="#831843">FalkorDB</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#831843">graph-falkordb</FONT></TD>
                    <TD BGCOLOR="#FDF2F8" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#831843">openCypher subset<BR/>Redis module</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native batch</FONT></TD>
                    <TD BGCOLOR="#FEF3C7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#92400E">Range index<BR/>no unique</FONT></TD>
                    <TD BGCOLOR="#DCFCE7" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#166534">Native MERGE</FONT></TD>
                    <TD BGCOLOR="#FEE2E2" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#991B1B">Explicit unsupported</FONT></TD>
                    <TD BGCOLOR="#FDF2F8" CELLPADDING="10"><FONT FACE="Comic Mono" POINT-SIZE="12" COLOR="#831843">Redis-backed graph service</FONT></TD>
                </TR>
                <TR>
                    <TD COLSPAN="7" BGCOLOR="#F8FAFC" CELLPADDING="12">
                        <FONT FACE="Comic Mono" POINT-SIZE="11" COLOR="#475569">Source: root README backend comparison plus graph-core schema, merge, and transaction support matrices. Metric direction and backend recommendations are documented in benchmark/README.md.</FONT>
                    </TD>
                </TR>
            </TABLE>
        >
    ];
}
