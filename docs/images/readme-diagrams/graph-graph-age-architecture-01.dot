digraph "graph-graph-age-architecture-01" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="Module Layer Structure";
  n0 [label="graph-core (GraphOperations interface)", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="graph-age (AgeGraphOperations)", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="core", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="AgeSql (Cypher → SQL)", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="PostgreSQL AGE (ag_catalog.cypher)", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="Age Property Serializer (value serialization)", fillcolor="#F1ECFF", color="#8A72D6"];
  n6 [label="AgeTypeParser (agtype parsing)", fillcolor="#F7F1E7", color="#B88A44"];
  n7 [label="Exposed Database (JDBC transaction)", fillcolor="#EEF6D9", color="#8BA84D"];
  n8 [label="HikariCP (connection pool)", fillcolor="#E8F3FF", color="#5B8DEF"];
  n8 -> n7 [style="solid"];
  n7 -> n4 [style="solid"];
  n6 -> n1 [style="solid"];
  n5 -> n3 [style="solid"];
  n3 -> n4 [style="solid"];
  n1 -> n3 [style="solid"];
  n0 -> n2 [style="solid"];
}
