digraph "graph-graph-neo4j-architecture-11" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="Neo4j";
  n0 [label="Neo4j Data Model", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="Node ()", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="Relationship ()", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="Properties ()", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="elementId() 3:00:00:00:01", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="labels() [User, Admin]", fillcolor="#F1ECFF", color="#8A72D6"];
  n6 [label="asMap() {name, email, age}", fillcolor="#F7F1E7", color="#B88A44"];
  n7 [label="elementId() 5:00:00:00:01", fillcolor="#EEF6D9", color="#8BA84D"];
  n8 [label="type() KNOWS", fillcolor="#E8F3FF", color="#5B8DEF"];
  n9 [label="startNodeElementId()", fillcolor="#EAF7EF", color="#58A978"];
  n10 [label="endNodeElementId()", fillcolor="#FFF3D9", color="#D6A441"];
  n11 [label="asMap() {since, weight}", fillcolor="#FDECEF", color="#DC6B82"];
  n12 [label="GraphVertex", fillcolor="#E9F7F6", color="#45A7A1"];
  n13 [label="GraphEdge", fillcolor="#F1ECFF", color="#8A72D6"];
  n11 -> n13 [style="solid"];
  n10 -> n13 [style="solid"];
  n9 -> n13 [style="solid"];
  n8 -> n13 [style="solid"];
  n7 -> n13 [style="solid"];
  n6 -> n12 [style="solid"];
