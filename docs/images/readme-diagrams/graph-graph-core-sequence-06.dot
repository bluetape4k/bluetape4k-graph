digraph "graph-graph-core-sequence-06" {
  graph [rankdir=LR, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="createVertex";
  a0 [label="User Code", fillcolor="#F4F7FA", color="#8CA0B8"];
  a1 [label="GraphOperations Implementation", fillcolor="#F4F7FA", color="#8CA0B8"];
  a2 [label="Backend Driver AGE / Neo4j", fillcolor="#F4F7FA", color="#8CA0B8"];
  a3 [label="Database", fillcolor="#F4F7FA", color="#8CA0B8"];
  a0 -> a1 [style="solid"];
  a1 -> a2 [style="solid"];
  a2 -> a3 [style="solid"];
  a3 -> a2 [style="dashed"];
  a2 -> a2 [style="solid"];
  a2 -> a1 [style="dashed"];
  a1 -> a0 [style="dashed"];
}
