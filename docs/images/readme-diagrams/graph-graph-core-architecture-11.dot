digraph "graph-graph-core-architecture-11" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="GraphOperations";
  n0 [label="INITIALIZED", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="VERTEX_OPS:", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="VERTEX_OPS", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="EDGE_OPS:", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="EDGE_OPS", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="TRAVERSAL_OPS:", fillcolor="#F1ECFF", color="#8A72D6"];
  n6 [label="TRAVERSAL_OPS", fillcolor="#F7F1E7", color="#B88A44"];
  n7 [label="INITIALIZED:", fillcolor="#EEF6D9", color="#8BA84D"];
  n8 [label="CLOSED:", fillcolor="#E8F3FF", color="#5B8DEF"];
  n0 -> n8 [style="solid"];
  n6 -> n7 [style="solid"];
  n6 -> n5 [style="solid"];
  n4 -> n5 [style="solid"];
  n4 -> n3 [style="solid"];
  n2 -> n3 [style="solid"];
  n2 -> n1 [style="solid"];
  n0 -> n1 [style="solid"];
}
