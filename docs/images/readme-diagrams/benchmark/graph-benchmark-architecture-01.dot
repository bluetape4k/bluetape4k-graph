digraph "benchmark/graph-benchmark-architecture-01" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="graph-benchmark Architecture";
  n0 [label="JMH Runner kotlinx.benchmark State opened for JMH Average time in microseconds", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="Benchmark Suites PageRank, BFS, DFS neighbors and paths 10k loop vs batch inserts", fillcolor="#EAF8EF", color="#55B978"];
  n2 [label="API Paths sync GraphOperations virtual-thread adapters algorithm adapter", fillcolor="#FFF4DE", color="#F3B34C"];
  n3 [label="TinkerGraph in-memory backend no external container shared fixture state", fillcolor="#FCE9F1", color="#E879A6"];
  n4 [label="Measurement Focus Core graph API overhead Sync vs virtual-thread wrappers Batch write throughput shape", fillcolor="#F8FAFC", color="#CBD5E1"];
  n0 -> n1 [style="solid"];
  n1 -> n2 [style="solid"];
  n2 -> n3 [style="solid"];
  n3 -> n4 [style="solid"];
}
