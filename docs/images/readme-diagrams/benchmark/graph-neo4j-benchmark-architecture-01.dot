digraph "benchmark/graph-neo4j-benchmark-architecture-01" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="graph-neo4j-benchmark Architecture";
  n0 [label="JMH Runner kotlinx.benchmark warmup + measure JSON report format", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="Neo4j Benchmarks vertex and edge operations 10k loop vs batch inserts shortestPath and allPaths", fillcolor="#EAF8EF", color="#55B978"];
  n2 [label="Neo4j API Neo4jGraphOperations single-thread cache wrapper Neo4j Java Driver", fillcolor="#FFF4DE", color="#F3B34C"];
  n3 [label="Neo4j Server Testcontainers launcher Bolt runtime modules seeded fixture graph", fillcolor="#FCE9F1", color="#E879A6"];
  n4 [label="Seeded Fixture Person vertices: Alice, Bob, Charlie, Dave KNOWS chain plus FOLLOWS shortcut 10k generated write batches", fillcolor="#F8FAFC", color="#CBD5E1"];
  n0 -> n1 [style="solid"];
  n1 -> n2 [style="solid"];
  n2 -> n3 [style="solid"];
  n3 -> n4 [style="solid"];
