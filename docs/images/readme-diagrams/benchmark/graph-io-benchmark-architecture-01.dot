digraph "benchmark/graph-io-benchmark-architecture-01" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="graph-io-benchmark Architecture";
  n0 [label="JMH Runner sizeName parameter small and medium data trial-level setup", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="Format Suites CSV Jackson 2 and 3 NDJSON GraphML", fillcolor="#EAF8EF", color="#55B978"];
  n2 [label="I/O Adapters sync import/export virtual-thread adapters coroutine adapters", fillcolor="#FFF4DE", color="#F3B34C"];
  n3 [label="Storage Layer temporary files OkIO path sources GZIP NDJSON path", fillcolor="#FCE9F1", color="#E879A6"];
  n4 [label="Benchmark Dataset TinkerGraphOperations source graph export, import, round-trip teardown removes temp files", fillcolor="#F8FAFC", color="#CBD5E1"];
  n0 -> n1 [style="solid"];
  n1 -> n2 [style="solid"];
  n2 -> n3 [style="solid"];
  n3 -> n4 [style="solid"];
}
