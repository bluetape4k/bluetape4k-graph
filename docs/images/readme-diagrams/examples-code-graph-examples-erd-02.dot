digraph examples_code_graph_examples_erd_02 {
  graph [rankdir=LR, bgcolor="transparent", margin=0.1, nodesep=0.7, ranksep=0.9]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#9aa8b8", fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#738295", arrowsize=0.8]
  module [label="Module"];
  class [label="Class"];
  function [label="Function"];
  external [label="Other Module"];
  class -> module [label="BELONGS_TO"];
  function -> module [label="BELONGS_TO"];
  module -> external [label="DEPENDS_ON"];
  class -> class [label="IMPORTS / EXTENDS"];
  function -> function [label="CALLS"];
}
