digraph examples_ktor_graph_examples_data_flow_03 {
  graph [rankdir=LR, bgcolor="transparent", margin=0.1, nodesep=0.7, ranksep=0.9]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#9aa8b8", fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#738295", arrowsize=0.8]
  reset [label="POST /demo/reset"];
  store [label="Graph Backend"];
  count [label="GET /cities/count"];
  path [label="GET /cities/path"];
  reset -> store [label="write"];
  store -> count [label="read"];
  store -> path [label="traverse"];
}
