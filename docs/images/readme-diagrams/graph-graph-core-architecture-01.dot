digraph "graph-graph-core-architecture-01" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="Architecture Overview";
  n0 [label="Application Layer", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="graph-core Models, Schema DSL, Repository", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="graph-age Apache AGE Implementation", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="graph-neo4j Neo4j Implementation", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="graph-memgraph Memgraph Implementation", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="graph-tinkerpop TinkerGraph Implementation", fillcolor="#F1ECFF", color="#8A72D6"];
  n1 -> n5 [style="solid"];
  n1 -> n4 [style="solid"];
  n1 -> n3 [style="solid"];
  n1 -> n2 [style="solid"];
  n0 -> n1 [style="solid"];
}
