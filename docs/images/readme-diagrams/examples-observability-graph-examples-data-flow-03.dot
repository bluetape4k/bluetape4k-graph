digraph examples_observability_graph_examples_data_flow_03 {
  graph [rankdir=LR, bgcolor="transparent", margin=0.1, nodesep=0.7, ranksep=0.9]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#9aa8b8", fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#738295", arrowsize=0.8]
  csv [label="CSV Fixture"];
  loader [label="Dataset Loader"];
  service [label="Incident Service"];
  answers [label="Expected Output"];
  csv -> loader [label="load"];
  loader -> service [label="query"];
  service -> answers [label="assert"];
}
