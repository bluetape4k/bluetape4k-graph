digraph "graph-graph-neo4j-architecture-09" {
  graph [rankdir=TB, splines=ortho, nodesep=0.78, ranksep=0.86, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Sans MS", fontsize=12, margin="0.15,0.08"];
  edge [color="#758297", penwidth=2.0, arrowsize=0.8, fontname="Comic Sans MS", fontsize=10];
  label="neighbors Cypher";
  n0 [label="neighbors(startId, edgeLabel, direction, depth)", fillcolor="#E8F3FF", color="#5B8DEF"];
  n1 [label="direction?", fillcolor="#EAF7EF", color="#58A978"];
  n2 [label="(start)-[:LABEL*dept h]->(neighbor)", fillcolor="#FFF3D9", color="#D6A441"];
  n3 [label="(start)<-[:LABEL* depth]-(neighbor)", fillcolor="#FDECEF", color="#DC6B82"];
  n4 [label="(start)-[:LABEL*dept h]-(neighbor)", fillcolor="#E9F7F6", color="#45A7A1"];
  n5 [label="MATCH (start)-[:LABEL*..de pth]->(neighbor)", fillcolor="#F1ECFF", color="#8A72D6"];
  n6 [label="MATCH (start)<-[:LABEL* ..depth]-(neighbor)", fillcolor="#F7F1E7", color="#B88A44"];
  n7 [label="MATCH (start)-[:LABEL*..de pth]-(neighbor)", fillcolor="#EEF6D9", color="#8BA84D"];
  n8 [label="executeQuery()", fillcolor="#E8F3FF", color="#5B8DEF"];
  n9 [label="Neo4jRecordMapper .record To Vertex(record,", fillcolor="#EAF7EF", color="#58A978"];
  n10 [label="List<Graph Vertex>", fillcolor="#FFF3D9", color="#D6A441"];
  n9 -> n10 [style="solid"];
  n8 -> n9 [style="solid"];
  n7 -> n8 [style="solid"];
  n6 -> n8 [style="solid"];
  n5 -> n8 [style="solid"];
  n4 -> n7 [style="solid"];
  n3 -> n6 [style="solid"];
  n2 -> n5 [style="solid"];
  n1 -> n4 [style="solid"];
  n1 -> n3 [style="solid"];
  n1 -> n2 [style="solid"];
  n0 -> n1 [style="solid"];
}
